    { "id": "route-agent", "from": "route", "to": "agent", "label": "analysis", "variant": "emphasis", "role": "main", "fromSide": "bottom", "toSide": "top", "route": "drop" },
    { "id": "route-fast", "from": "route", "to": "fast", "variant": "dashed", "role": "branch", "fromSide": "right", "toSide": "left", "route": "up-channel" },
    { "id": "agent-tools", "from": "agent", "to": "tools", "variant": "emphasis", "role": "main", "fromSide": "right", "toSide": "left" },
    { "id": "tools-agent", "from": "tools", "to": "agent", "label": "观察 → 再想（循环）", "variant": "emphasis", "role": "return", "fromSide": "top", "toSide": "top", "route": "up-channel" },
    { "id": "agent-final", "from": "agent", "to": "finalize", "label": "条件边② 无 tool_calls", "variant": "emphasis", "role": "main", "fromSide": "bottom", "toSide": "left", "route": "bottom-channel" },
    { "id": "fast-final", "from": "fast", "to": "finalize", "variant": "dashed", "role": "branch", "fromSide": "right", "toSide": "top", "route": "outside-right" }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "四个概念在图上的位置",
      "items": [
        "State：共享 TypedDict，所有节点读写同一份",
        "Node：带 Node 角标的框，返回 state 的增量",
        "Edge：实线箭头，一定走这条",
        "Conditional Edge：标「条件边①②」的框，按 state 决定出口"
      ]
    },
    {
      "dot": "rose",
      "title": "两条条件边各读什么",
      "items": [
        "① 读 intent → 6 出口，analysis 才进 ReAct",
        "② 读 retry · deadline · tool_calls → 继续或收口",
        "写 state 的是节点，读 state 做决策的是条件边",
        "agent ⇄ tools 那条回边就是 ReAct 循环本身"
      ]
    }
  ]
}
