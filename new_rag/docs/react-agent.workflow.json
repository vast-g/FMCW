    { "id": "tools", "label": "④ 工具节点 Node" },
    { "id": "out", "label": "⑤ 收口节点 Node" }
  ],
  "phases": [
    { "id": "recognize", "label": "识别 → 写 state", "fromCol": 0, "toCol": 2 },
    { "id": "cycle", "label": "条件边读 state", "fromCol": 3, "toCol": 4, "variant": "emphasis" },
    { "id": "close", "label": "收口", "fromCol": 5, "toCol": 5, "variant": "dashed" }
  ],
  "mainPath": ["user", "classify", "loadmem", "route", "agent", "finalize"],
  "nodes": [
    { "id": "user", "lane": "intake", "col": 0, "type": "external", "label": "用户提问", "width": 72 },
    { "id": "classify", "lane": "intake", "col": 1, "type": "backend", "label": "classify", "sublabel": "写 intent", "tag": "Node", "width": 72 },
    { "id": "route", "lane": "intake", "col": 3, "type": "security", "label": "条件边①", "sublabel": "读 intent", "tag": "6 出口", "width": 72 },
    { "id": "fast", "lane": "intake", "col": 5, "type": "backend", "label": "其余 5 条路", "sublabel": "另 5 条", "tag": "Node", "width": 72 },
    { "id": "loadmem", "lane": "memory", "col": 2, "type": "database", "label": "load_memory", "sublabel": "画像+摘要", "tag": "Node", "width": 72 },
    { "id": "agent", "lane": "loop", "col": 3, "type": "backend", "label": "agent", "sublabel": "写 messages", "tag": "Node", "width": 72 },
    { "id": "tools", "lane": "tools", "col": 5, "type": "messagebus", "label": "tools", "sublabel": "写观察", "tag": "Node", "width": 72 },
    { "id": "finalize", "lane": "out", "col": 5, "type": "backend", "label": "finalize", "sublabel": "取答案", "tag": "Node", "width": 72 }
  ],
  "edges": [
    { "id": "ask", "from": "user", "to": "classify", "variant": "default", "fromSide": "right", "toSide": "left", "route": "up-channel" },
