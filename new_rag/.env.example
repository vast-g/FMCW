# ═══════════════════════════════════════════════════════════
# 环境变量模板 —— 复制为 .env 后填写
#   copy .env.example .env
# 优先级：环境变量 > .env > config.py 默认值
# ⚠️ .env 含密钥，已在 .gitignore 中排除
# ═══════════════════════════════════════════════════════════

# ── 应用 ──
APP_ENV=dev
LOG_LEVEL=info
# 无头模式（容器/CI/评测必须为 true）：不创建 tkinter 窗口、不启动摄像头与串口线程
HEADLESS=false

# ══════════════ 被测对象：本地小模型（Ollama）══════════════
# 必须与 `ollama list` 中实际已拉取的模型名一致
OLLAMA_MODEL=qwen3:4b
OLLAMA_EMBED_MODEL=qwen3-embedding:4b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_TIMEOUT=30

# qwen3 默认开启 thinking，会显著拖慢生成并干扰评测；保持 false
LLM_THINK=false
LLM_TEMPERATURE=0.0
LLM_NUM_PREDICT=512

# ══════════════ 裁判：阿里云百炼 ══════════════
# 评测结论的可信度取决于裁判质量。用 4B 本地模型当裁判会退化成"所有配置同分"，
# 因此裁判改用强模型；被测对象仍是本地小模型。
# 可选值：dashscope（推荐） | ollama
JUDGE_PROVIDER=dashscope
JUDGE_MODEL=glm-5.3
# 推理型裁判会先消耗 reasoning tokens，额度给小了 JSON 会被截断
JUDGE_MAX_TOKENS=1024
JUDGE_TEMPERATURE=0.0
JUDGE_NUM_PREDICT=256

# 在此填入你自己的百炼 API Key（不要提交到 git）
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ── 超时（秒）──
TIMEOUT_LLM_REWRITE=15
TIMEOUT_LLM_RERANK=15
TIMEOUT_LLM_JUDGE=90
TIMEOUT_EMBEDDING=30
TIMEOUT_HTTP_TOOL=5
TIMEOUT_MYSQL_CONNECT=3
TIMEOUT_REQUEST_BUDGET=90
TIMEOUT_REACT_BUDGET=60

# ── 重试 / ReAct ──
RETRY_MAX_ATTEMPTS=2
RETRY_BACKOFF_BASE=0.5
REACT_MAX_ITERATIONS=5

# ── RAG ──
CHUNK_SIZE=200
CHUNK_OVERLAP=20
RAG_TOP_K=5
RERANK_TOP_K=5

# ── MySQL ──
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=Root@123456
DB_NAME=slope_agent

# ── 服务 ──
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# ── 业务阈值 ──
ALERT_COOLDOWN=10
ALERT_DISTANCE=0.3
CONF_THRESH=0.45

# ── 可观测性 ──
TRACE_ENABLED=true
FEEDBACK_DIR=./feedback
